{
  "theme": "viola",
  "model": "Qwen 2.5 14B (Ollama locale)",
  "temperature": 0.5,
  "language": "Italiano (IT)",
  "api_key": "",
  "gmail": {
    "email": "",
    "app_password": ""
  },
  "llm": {
    "provider": "ollama",
    "inference": {
      "max_concurrent": 1,
      "max_queue": 3
    },
    "prewarm": {
      "enabled": "auto",
      "delay_seconds": 45,
      "keep_alive": "10m",
      "min_vram_gb": 4,
      "retry_seconds": 20,
      "max_retries": 3
    },
    "ollama": {
      "base_url": "http://127.0.0.1:11434",
      "model": "qwen2.5:14b-instruct-q4_0",
      "_model_alternatives": [
        "qwen2.5:14b-instruct-q4_0",
        "nstone-marmo:latest"
      ],
      "timeout_seconds": 180,
      "keep_alive_operational": "2m",
      "keep_alive_production": "5m"
    },
    "gemini": {
      "model": "gemini-1.5-flash"
    },
    "contexts": {
      "offerte": { "temperature": 0.55, "num_ctx": 4096, "num_predict": 600 },
      "ordini": { "temperature": 0.20, "num_ctx": 4096, "num_predict": 400 },
      "produzione": { "temperature": 0.25, "num_ctx": 4096, "num_predict": 800 }
    }
  },
  "logistics": {
    "api_key": "",
    "map_poll_seconds": 8,
    "default_map_center": [45.46, 9.19],
    "default_map_zoom": 13
  },
  "machines": {
    "multifilo": {
      "ip": "127.0.0.1",
      "port": 102,
