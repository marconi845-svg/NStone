      "ip": "127.0.0.1",
      "port": 102,
      "rack": 0,
      "slot": 1,
      "mode": "sim"
    },
    "cnc": {
      "ip": "127.0.0.1",
      "port": 102,
      "rack": 0,
      "slot": 1,
      "mode": "sim",
      "map_profile": "oem_cnc_v1"
    }
  },
  "autonomy": {
    "level": 0,
    "max_level": 2,
    "office_auto_email": false,
    "office_auto_stock": false,
    "plant_auto_plc_write": false,
    "plant_sim_only": true,
    "require_pin_above": 2,
    "admin_pin_hash": "",
